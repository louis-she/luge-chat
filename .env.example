# Copy to .env.local for Expo development (gitignored).
# Keys: ssh luge@luge.chat → cd ~/supabase-project && sh run.sh secrets

EXPO_PUBLIC_SUPABASE_URL=https://api.luge.chat
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_DB_SCHEMA=dev

# 微信开放平台 AppID（可公开）
EXPO_PUBLIC_WECHAT_APP_ID=wx670d93537c72d57a
# iOS Universal Link，须与微信开放平台配置一致
EXPO_PUBLIC_WECHAT_UNIVERSAL_LINK=https://luge.chat/app/

# 模拟器调试 UI（问路框、手动坐标、沙盒登录）；npm run start:ios 会自动设为 1
# EXPO_PUBLIC_DEV_SIMULATOR_UI=1

# 开发定位：模拟器默认旧金山坐标会自动替换为下方成都测试点
# EXPO_PUBLIC_DEV_USE_REAL_GPS=1        # 强制用模拟器/真机原始 GPS
# EXPO_PUBLIC_DEV_USE_MOCK_LOCATION=1   # 强制始终用 mock
EXPO_PUBLIC_DEV_LAT=30.6568
EXPO_PUBLIC_DEV_LNG=104.0652
EXPO_PUBLIC_DEV_HEADING=70

# 真机语音：rtc（火山 RTC，默认）| legacy / http（旧 ASR + luge-chat + HTTP TTS）
# EXPO_PUBLIC_LUGE_VOICE_PATH=rtc

# 主动讲解 span（开发可调小以便模拟器测试）
# EXPO_PUBLIC_PROACTIVE_MIN_DISTANCE_KM=20
# EXPO_PUBLIC_PROACTIVE_MIN_CHECK_MINUTES=10
# EXPO_PUBLIC_PROACTIVE_MIN_SPEAK_MINUTES=15

# 服务器 Edge Function 环境变量（勿放客户端）：
# GUEST_FREE_ASKS=3
# NEW_USER_BONUS_ASKS=30
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash          # 默认回退模型
# DEEPSEEK_JUDGE_MODEL=deepseek-v4-flash    # 是否回答判定（建议更便宜）
# DEEPSEEK_ANSWER_MODEL=deepseek-v4-flash   # 正式回答（建议更强）
# VOLCANO_TTS_API_KEY=          # 火山豆包语音 API Key（控制台 → API Key 管理）
# VOLCANO_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCANO_TTS_SPEAKER=zh_female_peiqi_uranus_bigtts

# 方案甲：火山 RTC / AI 音视频互动（仅服务器 .env，勿放客户端）
# VOLC_RTC_APP_ID=
# VOLC_RTC_APP_KEY=
# VOLC_ARK_ENDPOINT_ID=
# VOLC_ARK_API_KEY=
